{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "protocol",
  "version": "0.1.0",
  "identifier": "com.protocol.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Protocol",
        "width": 460,
        "height": 640,
        "minWidth": 360,
        "minHeight": 240,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "contentProtected": true,
        "center": false,
        "skipTaskbar": false,
        "focus": false,
        "focusable": false,
        "visible": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/base.vhdx",
      "../scripts/*.ps1"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  }
}